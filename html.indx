    <!-- JavaScript Controllers -->
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // Toast Notification System
        function openToast(title, message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-message').innerText = message;
            toast.classList.remove('translate-y-32', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-32', 'opacity-0');
            }, 3500);
        }

        // Modals
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // Game Filtering
        function filterGames(category) {
            const buttons = document.querySelectorAll('.game-filter-btn');
            buttons.forEach(btn => {
                btn.classList.remove('bg-emerald', 'text-obsidian', 'emerald-glow');
                btn.classList.add('bio-glass', 'text-slate-300');
            });
            event.target.classList.remove('bio-glass', 'text-slate-300');
            event.target.classList.add('bg-emerald', 'text-obsidian', 'emerald-glow');

            const cards = document.querySelectorAll('.game-card');
            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Open Game Details Modal
        function openGameModal(title, description, image) {
            const content = document.getElementById('gameModalContent');
            content.innerHTML = `
                <div class="relative h-64 rounded-2xl overflow-hidden mb-4">
                    <img src="${image}" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent"></div>
                </div>
                <h3 class="font-orbitron font-bold text-2xl text-white uppercase">${title}</h3>
                <p class="text-slate-300 text-sm font-poppins">${description}</p>
                <div class="flex items-center justify-between pt-4 border-t border-emerald/20">
                    <div class="flex items-center space-x-2 text-emerald text-xs font-orbitron">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald animate-pulse"></span>
                        <span>Bio-Servers Online • 144 FPS Ready</span>
                    </div>
                    <button onclick="closeModal('gameModal'); openToast('Deploying Sector', '${title} initialization sequence started...');" class="px-6 py-3 rounded-xl bg-gradient-to-r from-emerald to-amber text-obsidian font-orbitron text-xs font-bold uppercase emerald-glow hover:opacity-90">
                        Launch Sector
                    </button>
                </div>
            `;
            openModal('gameModal');
        }

        // Open News Modal
        function openNewsModal(title, text) {
            const content = document.getElementById('newsModalContent');
            content.innerHTML = `
                <h3 class="font-orbitron font-bold text-xl text-white uppercase">${title}</h3>
                <p class="text-slate-300 text-sm font-poppins leading-relaxed">${text}</p>
                <p class="text-xs text-slate-400 italic pt-2 font-rajdhani">Decrypted from Nexora Intelligence Bureau.</p>
                <button onclick="closeModal('newsModal')" class="w-full py-3 rounded-xl bg-emerald text-obsidian font-orbitron text-xs font-bold uppercase mt-4">Close Intel</button>
            `;
            openModal('newsModal');
        }

        // Tournament Registration
        function registerTournament(name) {
            openToast('Squad Enrolled!', `Successfully registered for ${name}. Prepare for combat.`);
        }

        // Newsletter Handler
        function handleNewsletter(e) {
            e.preventDefault();
            openToast('Dispatch Linked!', 'You are now synced with Nexora Solar Dispatches.');
            e.target.reset();
        }

        // Auth Handler
        function handleAuth(e) {
            e.preventDefault();
            closeModal('authModal');
            openToast('Neural Link Established!', 'Welcome back, Operative Kael.');
        }

        // Live Countdown Simulation
        function updateCountdowns() {
            let sec1 = 345000;
            setInterval(() => {
                sec1--;
                let d = Math.floor(sec1 / (3600*24));
                let h = Math.floor((sec1 % (3600*24)) / 3600);
                let m = Math.floor((sec1 % 3600) / 60);
                const el = document.getElementById('timer-1');
                if(el) el.innerText = `${d}D : ${h}H : ${m}M`;
            }, 1000);
        }
        updateCountdowns();
    </script>
</body>
</html>
