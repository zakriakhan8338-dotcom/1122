<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXORA GAMING — Solar Bio-Mech Universe</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        obsidian: '#05050A',
                        charcoal: '#0E1118',
                        titanium: '#161B22',
                        emerald: {
                            DEFAULT: '#00FF88',
                            dark: '#00CC6A',
                            light: '#66FFB2'
                        },
                        amber: {
                            DEFAULT: '#FF9900',
                            dark: '#CC7A00',
                            light: '#FFB333'
                        }
                    },
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
                        poppins: ['Poppins', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Orbitron, Rajdhani, Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Poppins:wght@300;400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #05050A;
            color: #FFFFFF;
            overflow-x: hidden;
        }
        h1, h2, h3, h4, h5, h6, .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        .font-rajdhani {
            font-family: 'Rajdhani', sans-serif;
        }
        /* Bio-Mech Holographic Glassmorphism */
        .bio-glass {
            background: rgba(14, 17, 24, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 255, 136, 0.15);
            box-shadow: inset 0 0 15px rgba(0, 255, 136, 0.03);
        }
        .bio-glass:hover {
            border-color: rgba(255, 153, 0, 0.4);
            box-shadow: 0 0 30px rgba(255, 153, 0, 0.15), inset 0 0 20px rgba(255, 153, 0, 0.05);
        }
        .emerald-glow {
            box-shadow: 0 0 35px rgba(0, 255, 136, 0.35);
        }
        .amber-glow {
            box-shadow: 0 0 35px rgba(255, 153, 0, 0.35);
        }
        .text-bio-gradient {
            background: linear-gradient(135deg, #00FF88 0%, #FF9900 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .bg-hex-grid {
            background-image: linear-gradient(30deg, rgba(0, 255, 136, 0.03) 12%, transparent 12.5%, transparent 87%, rgba(0, 255, 136, 0.03) 87.5%, rgba(0, 255, 136, 0.03)),
                              linear-gradient(150deg, rgba(0, 255, 136, 0.03) 12%, transparent 12.5%, transparent 87%, rgba(0, 255, 136, 0.03) 87.5%, rgba(0, 255, 136, 0.03)),
                              linear-gradient(30deg, rgba(255, 153, 0, 0.03) 12%, transparent 12.5%, transparent 87%, rgba(255, 153, 0, 0.03) 87.5%, rgba(255, 153, 0, 0.03)),
                              linear-gradient(150deg, rgba(255, 153, 0, 0.03) 12%, transparent 12.5%, transparent 87%, rgba(255, 153, 0, 0.03) 87.5%, rgba(255, 153, 0, 0.03));
            background-size: 80px 140px;
            background-position: 0 0, 0 0, 40px 70px, 40px 70px;
        }
        /* Holographic Scanline Effect */
        .scanline::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            background-size: 100% 4px;
            z-index: 10;
            pointer-events: none;
            opacity: 0.3;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #05050A;
        }
        ::-webkit-scrollbar-thumb {
            background: #00FF88;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #FF9900;
        }
    </style>
</head>
<body class="bg-obsidian text-white bg-hex-grid relative selection:bg-emerald selection:text-obsidian">

    <!-- Toast Notification Banner -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-32 opacity-0 transition-all duration-300 bio-glass px-6 py-4 rounded-xl flex items-center space-x-3 shadow-2xl border-emerald/50">
        <i data-lucide="zap" class="w-6 h-6 text-emerald"></i>
        <div>
            <h4 id="toast-title" class="font-orbitron font-bold text-sm text-emerald">Bio-System Ready</h4>
            <p id="toast-message" class="text-xs text-slate-300">Action executed successfully.</p>
        </div>
    </div>

    <!-- Navigation Header -->
    <header class="fixed top-0 left-0 w-full z-40 bio-glass border-b border-emerald/20 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald to-amber p-0.5 flex items-center justify-center emerald-glow group-hover:rotate-45 transition-transform duration-500">
                    <div class="w-full h-full bg-obsidian rounded-[10px] flex items-center justify-center">
                        <i data-lucide="cpu" class="w-5 h-5 text-emerald group-hover:text-amber transition-colors"></i>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-orbitron font-black text-xl tracking-widest text-white">NEXORA</span>
                    <span class="text-[10px] font-rajdhani tracking-[0.25em] text-emerald font-bold -mt-1 uppercase">Bio-Mech Nexus</span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden md:flex items-center space-x-8 font-rajdhani text-base font-semibold tracking-wider">
                <a href="#hero" class="text-emerald hover:text-amber transition-colors">HOME</a>
                <a href="#games" class="text-slate-300 hover:text-emerald transition-colors">CATALOG</a>
                <a href="#tournaments" class="text-slate-300 hover:text-emerald transition-colors">ARENA</a>
                <a href="#leaderboard" class="text-slate-300 hover:text-emerald transition-colors">RANKINGS</a>
                <a href="#news" class="text-slate-300 hover:text-emerald transition-colors">INTEL</a>
                <a href="#community" class="text-slate-300 hover:text-emerald transition-colors">MATRIX</a>
                <a href="#profile" class="text-slate-300 hover:text-emerald transition-colors">DASHBOARD</a>
            </nav>

            <!-- Action CTAs & Mobile Toggle -->
            <div class="flex items-center space-x-4">
                <button onclick="openModal('authModal')" class="hidden sm:inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl font-orbitron text-xs font-bold uppercase tracking-wider bg-emerald hover:bg-emerald-dark text-obsidian emerald-glow transition-all duration-300 transform hover:-translate-y-0.5">
                    <i data-lucide="shield" class="w-4 h-4"></i>
                    <span>Link Neural ID</span>
                </button>
                <button id="menuBtn" class="md:hidden text-emerald hover:text-amber focus:outline-none p-2">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobileMenu" class="hidden md:hidden bio-glass border-t border-emerald/20 px-6 py-6 space-y-4 font-rajdhani text-lg">
            <a href="#hero" class="block text-emerald font-semibold py-1">HOME</a>
            <a href="#games" class="block text-slate-300 font-semibold py-1 hover:text-emerald">CATALOG</a>
            <a href="#tournaments" class="block text-slate-300 font-semibold py-1 hover:text-emerald">ARENA</a>
            <a href="#leaderboard" class="block text-slate-300 font-semibold py-1 hover:text-emerald">RANKINGS</a>
            <a href="#news" class="block text-slate-300 font-semibold py-1 hover:text-emerald">INTEL</a>
            <a href="#community" class="block text-slate-300 font-semibold py-1 hover:text-emerald">MATRIX</a>
            <a href="#profile" class="block text-slate-300 font-semibold py-1 hover:text-emerald">DASHBOARD</a>
            <button onclick="openModal('authModal')" class="w-full py-3 rounded-xl font-orbitron text-xs font-bold uppercase bg-emerald text-obsidian emerald-glow mt-2">Link Neural ID</button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="relative z-10 pt-20">

        <!-- 1 & 2. HOMEPAGE HERO SECTION -->
        <section id="hero" class="relative min-h-[92vh] flex items-center justify-center overflow-hidden py-20 px-4 sm:px-6 lg:px-8 scanline">
            <!-- Cinematic Bio-Mech Background Image & Glows -->
            <div class="absolute inset-0 z-0">
                <img src="https://images.unsplash.com/photo-1579546929518-9e396f3cc809?q=80&w=2000&auto=format&fit=crop" alt="Solar Bio-Mech Background" class="w-full h-full object-cover object-center opacity-20 scale-105">
                <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/60 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-obsidian via-transparent to-obsidian"></div>
                <!-- Ambient Solar Amber & Emerald Orbs -->
                <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-emerald/10 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
                <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-amber/10 rounded-full blur-3xl pointer-events-none animate-pulse duration-1000"></div>
            </div>

            <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
                <!-- Hero Left Content -->
                <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bio-glass border border-emerald/40 text-emerald text-xs font-orbitron uppercase tracking-widest emerald-glow">
                        <span class="w-2 h-2 rounded-full bg-emerald animate-ping"></span>
                        <span>Solar-Mech Epoch 5.0 — Online</span>
                    </div>

                    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black font-orbitron tracking-tight leading-none uppercase">
                        SYNCHRONIZE <br>
                        <span class="text-bio-gradient drop-shadow-lg">SOLAR EVOLUTION</span>
                    </h1>

                    <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 font-poppins font-light leading-relaxed">
                        "Unleash acid-neon bio-ware. Dominate alien star systems. Ascend to supreme immortal status in the Nexora Solar Matrix."
                    </p>

                    <!-- CTA Action Buttons -->
                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start space-y-4 sm:space-y-0 sm:space-x-5">
                        <a href="#games" class="w-full sm:w-auto px-8 py-4 rounded-xl font-orbitron text-sm font-bold uppercase tracking-wider bg-gradient-to-r from-emerald to-amber text-obsidian hover:opacity-90 emerald-glow transition-all duration-300 transform hover:-translate-y-1 text-center">
                            EXPLORE CATALOG
                        </a>
                        <a href="#community" class="w-full sm:w-auto px-8 py-4 rounded-xl font-orbitron text-sm font-bold uppercase tracking-wider bio-glass text-white hover:border-amber hover:bg-amber/10 transition-all duration-300 transform hover:-translate-y-1 text-center">
                            JOIN THE MATRIX
                        </a>
                    </div>

                    <!-- Hero Metrics -->
                    <div class="grid grid-cols-3 gap-4 pt-6 border-t border-emerald/20 max-w-lg mx-auto lg:mx-0">
                        <div>
                            <h4 class="font-orbitron font-bold text-2xl text-emerald">3.8M</h4>
                            <p class="text-xs text-slate-400 font-rajdhani tracking-wider uppercase">Active Operatives</p>
                        </div>
                        <div>
                            <h4 class="font-orbitron font-bold text-2xl text-amber">$1.25M</h4>
                            <p class="text-xs text-slate-400 font-rajdhani tracking-wider uppercase">Solar Bounties</p>
                        </div>
                        <div>
                            <h4 class="font-orbitron font-bold text-2xl text-white">240+</h4>
                            <p class="text-xs text-slate-400 font-rajdhani tracking-wider uppercase">Bio-Worlds</p>
                        </div>
                    </div>
                </div>

                <!-- Hero Right: Live Featured Game Card -->
                <div class="lg:col-span-5 flex justify-center">
                    <div class="w-full max-w-md bio-glass rounded-2xl p-5 relative group overflow-hidden amber-glow border border-amber/30">
                        <!-- Live Status Badge -->
                        <div class="absolute top-8 right-8 z-20 flex items-center space-x-2 bg-obsidian/90 backdrop-blur-md px-3 py-1.5 rounded-full border border-amber/50">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber animate-pulse"></span>
                            <span class="font-orbitron text-[10px] font-bold text-amber tracking-wider uppercase">FEATURED NEXUS</span>
                        </div>

                        <!-- Card Image -->
                        <div class="relative h-72 rounded-xl overflow-hidden mb-6">
                            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1000&auto=format&fit=crop" alt="Solar Titan" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                            <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent"></div>
                            <div class="absolute bottom-4 left-4">
                                <span class="px-2.5 py-1 rounded-md bg-amber/80 backdrop-blur-sm text-[10px] font-orbitron uppercase text-obsidian font-bold">Bio-Mech / Action</span>
                                <h3 class="font-orbitron font-bold text-2xl text-white mt-1">CHRONO-TITAN 9</h3>
                            </div>
                        </div>

                        <!-- Card Info -->
                        <div class="space-y-4">
                            <p class="text-slate-300 text-xs line-clamp-2">Pilot colossal bio-mechanical titans powered by solar fusion cores across collapsing alien galaxies.</p>
                            
                            <div class="flex items-center justify-between pt-2">
                                <div class="flex items-center space-x-2 text-xs text-slate-400 font-rajdhani">
                                    <i data-lucide="users" class="w-4 h-4 text-emerald"></i>
                                    <span>62,400 Units Active</span>
                                </div>
                                <button onclick="openGameModal('Chrono-Titan 9', 'Pilot colossal bio-mechanical titans powered by solar fusion cores across collapsing alien galaxies.', 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1000&auto=format&fit=crop')" class="px-4 py-2 rounded-xl bg-emerald text-obsidian font-orbitron text-xs font-bold uppercase hover:bg-emerald-light transition-colors">
                                    Initialize
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. FEATURED GAMES CATALOG SECTION -->
        <section id="games" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-emerald font-orbitron text-xs font-bold tracking-widest uppercase bg-emerald/10 px-4 py-1.5 rounded-full border border-emerald/20">BIO-TECH ARCHIVE</span>
                <h2 class="text-3xl sm:text-5xl font-black font-orbitron uppercase mt-4 mb-4">EXPLORE FEATURED <span class="text-bio-gradient">GAMES</span></h2>
                <p class="text-slate-400 text-sm sm:text-base font-poppins">Select your warfare sector across acid-neon tactical action, open-world survival, and zero-gravity racing.</p>
                
                <!-- Category Filter Tabs -->
                <div id="gameFilters" class="flex flex-wrap justify-center gap-2 sm:gap-3 mt-8">
                    <button onclick="filterGames('all')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bg-emerald text-obsidian emerald-glow">All Sectors</button>
                    <button onclick="filterGames('Action')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bio-glass text-slate-300 hover:text-white">Action</button>
                    <button onclick="filterGames('Adventure')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bio-glass text-slate-300 hover:text-white">Adventure</button>
                    <button onclick="filterGames('Racing')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bio-glass text-slate-300 hover:text-white">Racing</button>
                    <button onclick="filterGames('Shooting')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bio-glass text-slate-300 hover:text-white">Shooting</button>
                    <button onclick="filterGames('Sports')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bio-glass text-slate-300 hover:text-white">Sports</button>
                    <button onclick="filterGames('Strategy')" class="game-filter-btn px-4 py-2 rounded-xl font-orbitron text-xs font-bold uppercase transition-all bio-glass text-slate-300 hover:text-white">Strategy</button>
                </div>
            </div>

            <!-- Games Grid -->
            <div id="gamesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Card 1: Action -->
                <div class="game-card bio-glass rounded-2xl overflow-hidden group transition-all duration-300 hover:-translate-y-2 border border-emerald/20" data-category="Action">
                    <div class="relative h-56 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=800&auto=format&fit=crop" alt="Acid Stalker" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent"></div>
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-md bg-emerald text-[10px] font-orbitron uppercase font-bold text-obsidian">Action</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-orbitron font-bold text-xl text-white">Acid Stalker: Genesis</h3>
                        <p class="text-slate-400 text-xs line-clamp-2">Visceral underground bio-combats with acid-infused blade augmentations and synaptic reflex boosters.</p>
                        <div class="flex items-center justify-between pt-2 border-t border-emerald/20">
                            <span class="text-xs text-amber font-orbitron font-semibold">4.9 ★ (14.2k)</span>
                            <button onclick="openGameModal('Acid Stalker: Genesis', 'Visceral underground bio-combats with acid-infused blade augmentations and synaptic reflex boosters.', 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=800&auto=format&fit=crop')" class="px-4 py-2 rounded-xl bg-emerald hover:bg-emerald-dark text-obsidian font-orbitron text-xs font-bold uppercase transition-colors">Deploy</button>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Adventure -->
                <div class="game-card bio-glass rounded-2xl overflow-hidden group transition-all duration-300 hover:-translate-y-2 border border-emerald/20" data-category="Adventure">
                    <div class="relative h-56 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1612287233002-b1d0ba12c7c2?q=80&w=800&auto=format&fit=crop" alt="Bio-Eden" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent"></div>
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-md bg-amber text-[10px] font-orbitron uppercase font-bold text-obsidian">Adventure</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-orbitron font-bold text-xl text-white">Bio-Eden Awakening</h3>
                        <p class="text-slate-400 text-xs line-clamp-2">Traverse sentient overgrown alien rainforests and decipher ancient bio-luminescent glyphs.</p>
                        <div class="flex items-center justify-between pt-2 border-t border-emerald/20">
                            <span class="text-xs text-amber font-orbitron font-semibold">4.8 ★ (10.5k)</span>
                            <button onclick="openGameModal('Bio-Eden Awakening', 'Traverse sentient overgrown alien rainforests and decipher ancient bio-luminescent glyphs.', 'https://images.unsplash.com/photo-1612287233002-b1d0ba12c7c2?q=80&w=800&auto=format&fit=crop')" class="px-4 py-2 rounded-xl bg-emerald hover:bg-emerald-dark text-obsidian font-orbitron text-xs font-bold uppercase transition-colors">Deploy</button>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Racing -->
                <div class="game-card bio-glass rounded-2xl overflow-hidden group transition-all duration-300 hover:-translate-y-2 border border-emerald/20" data-category="Racing">
                    <div class="relative h-56 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop" alt="Solar Velocity" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent"></div>
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-md bg-emerald text-[10px] font-orbitron uppercase font-bold text-obsidian">Racing</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-orbitron font-bold text-xl text-white">Solar Velocity 9000</h3>
                        <p class="text-slate-400 text-xs line-clamp-2">Magnetic levitation super-jets racing along solar storm rings at Mach 12 velocities.</p>
                        <div class="flex items-center justify-between pt-2 border-t border-emerald/20">
                            <span class="text-xs text-amber font-orbitron font-semibold">4.9 ★ (18.1k)</span>
                            <button onclick="openGameModal('Solar Velocity 9000', 'Magnetic levitation super-jets racing along solar storm rings at Mach 12 velocities.', 'https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop')" class="px-4 py-2 rounded-xl bg-emerald hover:bg-emerald-dark text-obsidian font-orbitron text-xs font-bold uppercase transition-colors">Deploy</button>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Shooting -->
                <div class="game-card bio-glass rounded-2xl overflow-hidden group transition-all duration-300 hover:-translate-y-2 border border-emerald/20" data-category="Shooting">
                    <div class="relative h-56 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1542751110-97427bbecf20?q=80&w=800&auto=format&fit=crop" alt="Plasma Vanguard" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent"></div>
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-md bg-amber text-[10px] font-orbitron uppercase font-bold text-obsidian">Shooting</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-orbitron font-bold text-xl text-white">Plasma Phalanx</h3>
                        <p class="text-slate-400 text-xs line-clamp-2">Intense 5v5 tactical arena shooter featuring modular plasma rifles and kinetic shields.</p>
                        <div class="flex items-center justify-between pt-2 border-t border-emerald/20">
                            <span class="text-xs text-amber font-orbitron font-semibold">4.7 ★ (31.2k)</span>
